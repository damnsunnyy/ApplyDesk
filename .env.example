# Apply Desk / Wellfound Auto-Apply Configuration
# Inspired by https://github.com/ankitbaghel01/wellfound_autoApply

# Candidate Profile
FULL_NAME="Jane Doe"
EMAIL="jane.doe@example.com"
PHONE="+1-555-0199"
LOCATION="San Francisco, CA"
LINKEDIN_URL="https://linkedin.com/in/janedoe"
PORTFOLIO_URL="https://janedoe.dev"
GITHUB_URL="https://github.com/janedoe"
PROFESSIONAL_SUMMARY="Full Stack Software Engineer with 4+ years of experience building scalable web applications with React, Node.js, and TypeScript."
TECHNICAL_SKILLS="React, TypeScript, JavaScript, Node.js, Python, PostgreSQL, REST APIs, GraphQL, Docker, AWS"

# Job Filtering Preferences
TARGET_KEYWORDS="software engineer, frontend developer, full stack developer, web developer, react developer, backend engineer"
BLOCKLIST_KEYWORDS="senior, principal, director, manager, lead, staff, architect, intern"
COMPANY_BLOCKLIST="CompanyA, CompanyB"

# Application Answers & Form Defaults
WORK_AUTHORIZATION="Yes"
VISA_SPONSORSHIP="No"
WILLING_TO_RELOCATE="Yes"
YEARS_OF_EXPERIENCE="3"
SALARY_EXPECTATION="Negotiable"
NOTICE_PERIOD="Immediately"

# Custom Cover Letter Template (Optional)
# Leave blank to use smart generated template, or customize with:
# {company}, {title}, {name}, {skills}, {summary}, {email}, {phone}, {portfolio}, {linkedin}
COVER_LETTER_TEMPLATE=""

# Optional AI Answering (Google Gemini API Key for unknown startup questions)
GEMINI_API_KEY=""

# Automation Controls
DAILY_LIMIT=50
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=75

