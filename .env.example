# Copy to .env and replace each value with information from your own profile.
# Values are intentionally blank; the runner skips applications that need missing answers.

FULL_NAME=
EMAIL=
PHONE=
LOCATION=
LINKEDIN_URL=
PORTFOLIO_URL=
GITHUB_URL=
PROFESSIONAL_SUMMARY=
TECHNICAL_SKILLS=

TARGET_KEYWORDS=software engineer,frontend,backend,full stack,web developer
BLOCKLIST_KEYWORDS=senior,principal,director,manager,lead,staff,architect,intern
COMPANY_BLOCKLIST=

# Set these only when they are accurate for you.
WORK_AUTHORIZATION=
VISA_SPONSORSHIP=
WILLING_TO_RELOCATE=
YEARS_OF_EXPERIENCE=
SALARY_EXPECTATION=
NOTICE_PERIOD=

# Optional. Use only a cover note written for your own profile.
COVER_LETTER_TEMPLATE=

DAILY_LIMIT=50
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=150
