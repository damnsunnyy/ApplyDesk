{
  "manifest_version": 3,
  "name": "Apply Desk — Form & Wellfound Helper",
  "version": "1.3.0",
  "description": "Automate Wellfound job applications with HUD, dry-run mode, and sync to Apply Desk.",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "tabs"],
  "host_permissions": [
    "https://wellfound.com/*",
    "https://*.wellfound.com/*",
    "https://damnsunnyy.github.io/ApplyDesk/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apply Desk Helper"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://damnsunnyy.github.io/ApplyDesk/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["portal-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.min.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}
